{% set s = t.budget_summary %}{% set st = figs.budget.stats %}
<section id="budget_summary">
  <div class="kicker reveal">{{ num }} · {{ s.kicker }}</div>
  <h2 class="reveal">{{ s.title }}</h2>
  <p class="lead reveal">{{ s.lead }}</p>
  <div class="grid g3 reveal" style="margin:22px 0">
    <div class="card"><div class="stat">{{ "{:,.1f}".format(st.total / 1000000) }} M</div><small>{{ s.stats.total_costs }} ({{ st.y0 }}–{{ st.y1 }}), {{ t.ui.eur }}</small></div>
    <div class="card"><div class="stat">{{ "{:,.0f}".format(st.first / 1000) }}k</div><small>{{ s.stats.first_year }}</small></div>
    <div class="card"><div class="stat">{{ st.partners_pct }}%</div><small>{{ s.stats.partners_share }}</small></div>
    <div class="card"><div class="stat">{{ st.projects_pct }}%</div><small>{{ s.stats.projects_share }}</small></div>
    <div class="card"><div class="stat">{{ st.team_last }}</div><small>{{ s.stats.team_2033 }} ({{ s.team_unit }})</small></div>
  </div>
  <p class="note">{{ s.note }} <a href="#budget">{{ t.ui.read_annex }} ↓</a></p>
</section>
