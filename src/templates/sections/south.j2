{% set s = t.south %}
<section id="south">
  <div class="kicker reveal">{{ num }} · {{ s.kicker }}</div>
  <h2 class="reveal">{{ s.title }}</h2>
  <p class="lead reveal">{{ s.lead }}</p>
  <h3 style="margin-top:24px">{{ s.why_title }}</h3>
  <div class="grid g3 reveal">{% for c in s.why %}<div class="card"><b>{{ c.title }}</b><p>{{ c.text }}</p></div>{% endfor %}</div>
  <h3 style="margin-top:24px">{{ s.azimut_title }}</h3>
  <p class="lead">{{ s.azimut_text }}</p>
  <div class="grid g3 reveal">{% for c in s.azimut %}<div class="card"><b>{{ c.title }}</b><p>{{ c.text }}</p></div>{% endfor %}</div>
  <p class="note">{{ s.azimut_note }}</p>
  <h3 style="margin-top:24px">{{ s.transfer_title }}</h3>
  <p class="lead">{{ s.transfer_lead }}</p>
  <div class="grid g2 reveal">{% for c in s.transfer %}<div class="card"><b>{{ c.title }}</b><p>{{ c.text }}</p></div>{% endfor %}</div>
  <h3 style="margin-top:24px">{{ s.work_title }}</h3>
  <div class="grid g2 reveal">{% for c in s.work %}<div class="card engine"><b>{{ c.title }}</b><p>{{ c.text }}</p></div>{% endfor %}</div>
  <h3 style="margin-top:24px">{{ s.scope_title }}</h3>
  <div class="grid g2 reveal">
    <div class="card"><b>{{ s.scope_in_title }}</b><ul class="clean">{% for i in s.scope_in %}<li>{{ i }}</li>{% endfor %}</ul></div>
    <div class="card"><b>{{ s.scope_out_title }}</b><ul class="clean">{% for i in s.scope_out %}<li>{{ i }}</li>{% endfor %}</ul></div>
  </div>
  <h3 style="margin-top:24px">{{ s.open_title }}</h3>
  <div class="card"><ul class="clean">{% for i in s.open %}<li>{{ i }}</li>{% endfor %}</ul></div>
  <p class="note">{{ s.note }}</p>
</section>
