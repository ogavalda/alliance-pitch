{% set s = t.status %}
<section id="status">
  <div class="kicker reveal">{{ num }} · {{ s.kicker }}</div>
  <h2 class="reveal">{{ s.title }}</h2>
  <div class="grid g3">
    {% for c in s.columns %}<div class="card"><span class="badge b-{{ c.style }}">{{ c.badge }}</span><ul class="clean">
      {% for i in c['items'] %}<li>{{ i | replace('[external]', '<span class="badge b-ext">external</span>') }}</li>{% endfor %}</ul></div>{% endfor %}
  </div>
  <p class="note">{{ s.note }}</p>
</section>
